/*
=====================================================================================
Product Cost Segmentation
=====================================================================================

Script Purpose:
    - Segment products into different cost ranges.
    - Categorize products based on their individual cost.
    - Count the number of products within each cost segment.
    - Analyze the distribution of products across different price/cost levels.
=====================================================================================
*/

/*
segmenty products into cost ranges 
count how many products fall into each segment
*/
with cost_table as
(select 
product_key,
prodct_name,
cost,
CASE WHEN cost<100 then 'below 100'
     when cost between 100 and 500 then '100-500'
     when cost between 500 and 1000 then '500-1000'
     else 'Above 1000'
     end cost_range
from gold.dim_products
)

select 
count(prodct_name) as products,
cost_range
from cost_table
group by cost_range
order by products desc
