/*
=====================================================================================
Magnitude Analysis
=====================================================================================

Script Purpose:
    - Analyze the magnitude of customers, products, costs, and revenue across
      different business dimensions.
    - Analyze customer distribution by country and gender.
    - Analyze product distribution by category.
    - Calculate average product cost by category.
    - Identify revenue generated by product category and customer country.
    - Support comparison of business performance across different dimensions.
=====================================================================================
*/
-- Find the total customers by country
select 
country,
count(customer_key) as total_customers
from gold.dim_customers
group by country

-- Find the total customers by gender
select 
gender,
count(customer_key) as total_customers
from gold.dim_customers
group by gender

--find the total product by category
select 
category,
count(product_key) as total_product
from gold.dim_products
group by category

--What is the avarge costs in each category?
select 
category,
avg(cost) as avarage_cost
from gold.dim_products
group by category

--What is the total revenue generated for each category?
select 
p.category,
sum(f.sales_amount) revenue
from gold.dim_products p
left join gold.fact_sales f
on f.product_key=p.product_key
group by p.category
order by revenue desc

--What is the total revenue generated for each counrty?
select 
c.country,
sum(f.sales_amount) revenue
from gold.dim_customers c
left join gold.fact_sales f
on f.customer_key=c.customer_key
group by c.country
order by revenue desc





