/*
=====================================================================================
Change Over Time Analysis
=====================================================================================

Script Purpose:
    - Analyze sales performance across different time periods.
    - Track total sales, number of customers, and quantity sold over time.
    - Demonstrate different approaches for grouping and ordering data by date.
    - Compare yearly and year-month trends using SQL date functions.
=====================================================================================
*/

select
year(order_date) order_year,
sum(sales_amount) as total_sales,
count(distinct customer_key) toal_customers,
sum(quantity) as total_quantity
from gold.fact_sales
where order_date is not null
group by year(order_date)
order by year(order_date)


select
format(order_date, 'yyyy-MMM') order_year,
sum(sales_amount) as total_sales,
count(distinct customer_key) toal_customers,
sum(quantity) as total_quantity
from gold.fact_sales
where order_date is not null
group by format(order_date, 'yyyy-MMM')
order by format(order_date, 'yyyy-MMM')

select
datetrunc(year,order_date) order_year,
sum(sales_amount) as total_sales,
count(distinct customer_key) toal_customers,
sum(quantity) as total_quantity
from gold.fact_sales
where order_date is not null
group by datetrunc(year,order_date)
order by datetrunc(year,order_date)
