/*
=====================================================================================
Customer Segmentation
=====================================================================================

Script Purpose:
    - Analyze customer purchasing behavior using customer lifespan and total sales.
    - Calculate each customer's first and last order dates.
    - Measure customer lifespan in months.
    - Segment customers into VIP, Regular, and New customer groups.
    - Understand the distribution of customers across behavioral segments.
=====================================================================================
*/

with customers as (
select 
c.customer_key,
min(order_date) first_order,
max(order_date) last_order,
datediff(month,min(order_date),max(order_date)) as lifespan,
sum(f.price) as total_sales
from gold.fact_sales f
left join gold.dim_customers c
on c.customer_key=f.customer_key
group by c.customer_key
)
select 
customer_group,
count(customer_key)
from
(
select
customer_key,
case WHEN lifespan>=12 and total_sales>5000 then 'VIP'
     when lifespan>=12 and total_sales<=5000 then 'Regular'
     when lifespan<12 then 'New'
     else 'n/a'
     end customer_group
from customers
)t 
group by customer_group
